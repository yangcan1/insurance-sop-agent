# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Or ANTHROPIC_AUTH_TOKEN=...  (the SDK also picks up an `ant auth login` profile)
MODEL=claude-opus-5
# low | medium | high. Leave empty for models without effort support (e.g. claude-haiku-4-5)
EFFORT=low
# Fixed "today" so fixture deadlines (Mar/Apr 2026) are still open during the demo
DEMO_TODAY=2026-03-05
